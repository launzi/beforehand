# domains.local.toml: example. Copy this file to domains.local.toml to use it.
#
# The copy is excluded from version control. Never commit it.
# Entries here override the shipped domains.toml for the same host.
# A rule host applies to itself and to all of its subdomains.
#
# OPTIONAL: without this file the pipeline runs on domains.toml alone
# (that it still works without it is the test of the abstraction, and a test pins it).
#
# Why a separate file: where you work, which bank you use and which job sites you
# visit are personal data in themselves. The shipped file lists only general public
# services; your own hosts belong here only.

[work]
sensitivity = "none"
hosts = ["work.test"]   # internal systems: ERP, admin consoles, issue trackers

[finance]
sensitivity = "restricted"
hosts = ["finance.test"]   # banks, cards, brokerages

[career]
sensitivity = "restricted"
hosts = ["career.test"]   # job platforms, recruiters

[health]
sensitivity = "restricted"
hosts = ["health.test"]   # clinics, pharmacies

[personal]
sensitivity = "none"
hosts = ["personal.test"]
