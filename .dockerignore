# Deny by default: only public runtime modules and reviewed synthetic assets enter.
**
!Dockerfile
!Dockerfile.job
!browsing/
!browsing/agent.py
!browsing/providers.py
!browsing/trace.py
!browsing/signals.py
!browsing/mandate.py
!browsing/mandate.toml
!browsing/ingest.py
!browsing/scrub.py
!browsing/persona/
!browsing/persona/*.py
!browsing/persona/scenarios/
!browsing/persona/scenarios/*.toml
!browsing/web/
!browsing/web/*.py
!browsing/web/requirements.txt
!browsing/web/templates/
!browsing/web/templates/*.html
!browsing/web/profiles/
!browsing/web/profiles/*.toml
!browsing/web/fixtures/
!browsing/web/fixtures/*.json
!browsing/demo-assets/
!browsing/demo-assets/*.db
!browsing/demo-assets/*.db.json
# Defense in depth, including nested paths and accidental overrides.
**/raw/**
**/data/**
**/reports/**
**/*.local.*
**/.env*
**/.agent-scratch/**
**/__pycache__/**
**/.git/**
**/*secret*
!browsing/demo-assets/cache-*.json
